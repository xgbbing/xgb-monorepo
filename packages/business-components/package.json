{
  "name": "@xgb/business-components",
  "version": "0.1.0",
  "description": "组件功能描述",
  "files": [
    "esm",
    "cjs",
    "es2017",
    "dist"
  ],
  "main": "esm/index.js",
  "module": "esm/index.js",
  "types": "esm/index.d.ts",
  "exports": {
    ".": {
      "es2017": {
        "types": "./es2017/index.d.ts",
        "default": "./es2017/index.js"
      },
      "default": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    },
    "./*": "./*"
  },
  "sideEffects": [
    "dist/*",
    "*.scss",
    "*.less",
    "*.css"
  ],
  "scripts": {
    "start": "ice-pkg start",
    "build": "rimraf esm es2017 && ice-pkg build && father build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "icepkg",
    "react",
    "component"
  ],
  "dependencies": {
    "@ice/jsx-runtime": "^0.3.0",
    "@swc/helpers": "^0.5.1",
    "@xgb/common-components": "workspace:*",
    "react-markdown": "8.0.7",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "3.0.1",
    "less": "^4.4.1"
  },
  "devDependencies": {
    "@ice/pkg": "^1.6.2",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "typescript": "^4.9.4",
    "father": "^4.6.10"
  },
  "peerDependencies": {
    "react": "^17 || ^18"
  },
  "license": "MIT",
  "authors": [
    "xgb.xu@qq.com"
  ]
}
